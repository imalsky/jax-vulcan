# Byte-compiled / optimized
**/__pycache__/
*.py[codz]
*$py.class
*.so
*.dylib

# Internal working documents (4-doc policy: README.md is the tracked
# consumer-facing reference; CLAUDE.md, notes.md and todo.md are local-only).
CLAUDE.md
notes.md
todo.md

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Environments
.env
.venv
venv/
.envrc
.direnv/

# IDEs and editors
.idea/
.vscode/
.claude/settings.local.json
*.swp
*.swo
*~

# Type checkers / linters / test caches
.mypy_cache/
.ruff_cache/
.pytype/
.pytest_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Profiling
*.prof
prof/
*.lprof

# JAX / XLA caches and dumps
.jax_cache/
jax_cache/
xla_dump/
*.xla_pb

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Scratch / temp files
*.tmp
*.bak
*.orig
*.rej

# VULCAN simulation outputs
output/
*.vul

# Large scientific data formats (typically big binary arrays/tables)
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.parquet
# tests/data/*.npz stays ignored ON PURPOSE — all four regression oracles are
# regenerable from committed scripts (see tests/conftest.py's
# _EXPECTED_FIXTURES for the per-file command), so the ~36 MB of binaries do not
# belong in history. The coverage risk that comes with that — a fresh clone
# silently SKIPPING the tests that compare against them — is closed by the
# collection hook in tests/conftest.py, which FAILS with the regeneration
# command instead of skipping.
*.pkl
*.pickle
*.feather

# ML model checkpoints
*.pt
*.pt2
*.pth
*.ckpt
*.onnx

# Archives
*.zip
*.tar
*.tar.gz
*.tgz

# Logs
*.log
logs/

# Generated plots (the plot/ dir is for generated figures)
plot/*.png
plot/*.pdf
plot/*.jpg
plot/*.jpeg
plot/*.svg

# Generated example figures (examples/output/ is already covered by output/)
examples/plot/

# Generated benchmark figures. The scripts in benchmarks/ are tracked and each
# one regenerates its own figure and self-checks, so the images are build
# output, not source. Same reasoning as tests/data/*.npz below: keeping them
# committed put a fresh ~300 KB blob in history on every restyle.
benchmarks/*.png
benchmarks/*.pdf

# Local parity-comparison artifacts (figures, scripts, .vul/.npz dumps) vs shami vm_branch / VULCAN-master — not shipped
parity-tests/

# Benchmark / validation artifact bundles. Never shipped: these are local
# evidence sets (runs, .vul dumps, figures, timings). Kept outside the repo.
validation_artifacts/
validation_artifacts_*/
