# Minimal patch applied to a PRISTINE exoclime/VULCAN clone (HEAD 8970337)
# purely to make it RUN on this machine for the 2026-07-30 HD189 comparison.
# Nothing here changes physics. Saved per the plan's 'labelled isolated patch' rule.

--- vulcan_cfg.py.orig	2026-07-30 13:49:17
+++ vulcan_cfg.py	2026-07-30 13:51:02
@@ -154,14 +154,14 @@
 # ====== Setting up for ouwtput and plotting ======
 # plotting:
 plot_TP = False
-use_live_plot = True
+use_live_plot = False
 use_live_flux = False
 use_plot_end = False
 use_plot_evo = False
 use_save_movie = False
 use_flux_movie = False
 plot_height = False
-use_PIL = True 
+use_PIL = False 
 live_plot_frq = 10
 save_movie_rate = live_plot_frq
 y_time_freq = 1  #  storing data for every 'y_time_freq' step
@@ -171,3 +171,14 @@
 use_shark = False
 save_evolution = False   # save the evolution of chemistry (y_time and t_time) for every save_evo_frq step
 save_evo_frq = 10
+
+# ---------------------------------------------------------------------------
+# ADDED FOR THIS COMPARISON ONLY (2026-07-30). op.py reads these four
+# attributes but cfg_examples/vulcan_cfg_HD189.py does not define them, so the
+# shipped example cannot run against the shipped op.py without them. Values are
+# chosen to MATCH VULCAN-JAX's HD189.yaml so the two codes are compared on
+# identical numerics; the example itself is silent on all four.
+use_adapt_rtol = False
+rtol_min = 0.0
+rtol_max = 1.0
+use_fix_all_bot = False
--- make_chem_funs.py.orig	2026-07-30 13:49:17
+++ make_chem_funs.py	2026-07-30 13:49:17
@@ -721,8 +721,10 @@
     conserv_check = True
     compo = np.genfromtxt(vulcan_cfg.com_file,names=True,dtype=None)
     compo_row = list(compo['species'])
-    # Convert bytes to strings
-    compo_row = [str(sp) for sp in compo_row]
+    # PATCHED FOR THIS COMPARISON ONLY (2026-07-30): numpy>=1.24
+    # genfromtxt(dtype=None) yields numpy.bytes_, and str(b'OH') -> "b'OH'",
+    # which makes every compo_row.index(sp) below raise. decode() instead.
+    compo_row = [sp.decode() if isinstance(sp, bytes) else str(sp) for sp in compo_row]
     #print (compo_row)
     num_atoms = len(compo.dtype.names) - 2 # dtype.names returns the column names and -2 is for 'species' and 'mass'
  
